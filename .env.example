PORT=3000

# PostgreSQL connection string used by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Replace USER and PASSWORD with your own local PostgreSQL credentials.
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/task_management_db?schema=public"
